# Copy to .env and adjust as needed.
# Ports match the PM2 deploy (deploy.sh / ecosystem.config.cjs):
#   backend :9002   frontend :9001
MONGO_URI=mongodb://localhost:27017
DB_NAME=prep_dashboard
PORT=9002
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:9001

# Password for the dashboard login, also sent as the X-API-Key header on every
# request. REQUIRED -- the backend refuses to start without it.
# Generate one with:  openssl rand -hex 32
# Keep it here (backend/.env is gitignored), never in ecosystem.config.cjs.
APP_PASSWORD=
